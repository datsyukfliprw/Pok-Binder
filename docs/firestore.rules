rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedPlayer() {
      return request.auth != null &&
        request.auth.uid in [
          'REPLACE_WITH_DADS_FIREBASE_UID',
          'REPLACE_WITH_PLAYERS_FIREBASE_UID'
        ];
    }

    match /familyChat/{messageId} {
      allow get, list: if approvedPlayer();
      allow create: if approvedPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'text', 'sentAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.sentAt == request.time;
      allow update, delete: if false;
    }
  }
}
